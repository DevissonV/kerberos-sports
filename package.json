{
  "name": "kerberos-sports",
  "version": "0.1.0",
  "private": true,
  "description": "Kerberos Sports - PAPER FIRST / FOOTBALL / RESEARCH MVP",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/main.js",
    "scan": "npm run build && node -r dotenv/config dist/cli/scan.js",
    "telegram:smoke": "npm run build && node -r dotenv/config dist/cli/telegramSmoke.js",
    "start:dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "validate": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
