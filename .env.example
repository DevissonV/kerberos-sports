NODE_ENV=development

# API-Football (api-football.com) - fixtures/resultados
API_FOOTBALL_KEY=
# Base URL de API-Football. Default: https://v3.football.api-sports.io
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# OddsPapi (oddspapi.io) - cuotas Over/Under 2.5
ODDSPAPI_KEY=
# Opcional: base URL alternativa. Default: https://api.oddspapi.io
ODDSPAPI_BASE_URL=

# OpenAI-compatible Responses API para Luna (shadow only; sin valor real)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-5.6-luna
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1

# Analyst contextual opcional; desactivado por defecto y sin autoridad de apuesta.
LLM_ANALYST_ENABLED=false
LLM_ANALYST_MODEL=gpt-5-mini
MAX_LLM_ANALYSES_PER_TICK=5

# Telegram bot de KERBEROS SPORTS (propio, NO reutilizar el de Kerberos Crypto)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Guard del protocolo de producto: modo PAPER siempre; jamás ejecución real.
PAPER_ONLY=true

# Modo temporal de control cada 30 minutos (sin ejecución real).
REFINEMENT_MODE=false
MAX_ODDSPAPI_FULL_SCANS_PER_DAY=2
# Resumen diario, hora local America/Bogota (HH:mm).
DAILY_REPORT_TIME_BOGOTA=22:30

# Ruta del fichero SQLite del PaperBetStore. En producción (Railway) apuntar al
# volumen durable: /data/kerberos-sports.db
PAPER_BETS_DB_PATH=data/kerberos-sports.db

# KS-04: gate determinista para recomendaciones manuales. No ejecuta ni envía
# apuestas. BASE es el único tier activo por defecto; 15k/20k requieren flags.
PRODUCTION_RISK_BASE_STAKE_COP=10000
PRODUCTION_RISK_ELEVATED_STAKE_COP=15000
PRODUCTION_RISK_HIGH_STAKE_COP=20000
PRODUCTION_RISK_MAX_STAKE_COP=20000
PRODUCTION_RISK_MAX_BETS_PER_DAY=3
PRODUCTION_RISK_MAX_DAILY_EXPOSURE_COP=30000
PRODUCTION_RISK_MAX_DAILY_LOSS_COP=30000
PRODUCTION_RISK_MAX_OPEN_BETS=2
PRODUCTION_RISK_KILL_SWITCH=false
PRODUCTION_RISK_MANUAL_PAUSE=false
PRODUCTION_RISK_ENABLE_ELEVATED=false
PRODUCTION_RISK_ENABLE_HIGH=false
PRODUCTION_RISK_ACTIVE_TIER=BASE

# Ledger local de ejecuciones MANUALES. Está aislado del bankroll PAPER.
MANUAL_LEDGER_DB_PATH=data/kerberos-sports-ledger.db

# ====== PILOTO REAL (REAL_MANUAL) ======
# Modo de ejecucion: PAPER (default) | REAL_MANUAL. REAL_AUTOMATED esta prohibido.
EXECUTION_MODE=PAPER
# Variables obligatorias (fail-closed) si EXECUTION_MODE=REAL_MANUAL:
REAL_BANKROLL_COP=
REAL_MAX_STAKE_COP=
REAL_MAX_DAILY_EXPOSURE_COP=
REAL_MAX_DAILY_LOSS_COP=
REAL_MAX_OPEN_BETS=
